# ==============================================================================
# GM REFORMA EXPRESS — Variables de entorno
# ==============================================================================

# Entorno general
APP_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=https://www.reformaexpress.com

# Persistencia (PostgreSQL)
# En desarrollo local: postgresql://postgres:postgres@127.0.0.1:5432/reformaexpress
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/reformaexpress?schema=public"

# Autenticación y cifrado de sesiones
AUTH_SECRET="cambiar-en-produccion-por-un-secreto-seguro-minimo-32-caracteres"
AUTH_URL=https://www.reformaexpress.com
TOKEN_ENCRYPTION_KEY="clave-cifrado-tokens-aes-256-cambiar-en-produccion"

# Pagos — Stripe
# Claves secretas de Stripe (sk_test_... para pruebas, sk_live_... para producción)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Correo transaccional y marketing — Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=notificaciones.info@reformaexpress.com
RESEND_MARKETING_FROM_EMAIL=notificaciones.info@reformaexpress.com
RESEND_REPLY_TO_EMAIL=notificaciones.info@reformaexpress.com

# Facturación fiscal
# Proveedor disponible: 'test-adapter' o proveedor certificado
INVOICE_PROVIDER=test-adapter
INVOICE_PROVIDER_API_KEY=
INVOICE_PROVIDER_WEBHOOK_SECRET=

# Google Search Console y Analítica (Medición sujeta a consentimiento)
GOOGLE_SITE_VERIFICATION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://www.reformaexpress.com/api/integrations/google/callback
GOOGLE_SEARCH_CONSOLE_PROPERTY=
GOOGLE_ANALYTICS_PROPERTY_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Tareas en segundo plano y automatizaciones
JOBS_PROVIDER=internal-queue
JOBS_SIGNING_SECRET=secreto-para-firmar-solicitudes-de-cola
CRON_SECRET=secreto-para-disparar-cron-semanal

# Almacenamiento privado de documentos (S3 / R2 compatible)
PRIVATE_STORAGE_BUCKET=
PRIVATE_STORAGE_REGION=
PRIVATE_STORAGE_ACCESS_KEY_ID=
PRIVATE_STORAGE_SECRET_ACCESS_KEY=

# Dominios autorizados para imágenes externas mediante URL (separados por coma)
IMAGE_CDN_ALLOWED_HOSTS="images.unsplash.com,res.cloudinary.com,imagedelivery.net,www.reformaexpress.com"

# Interruptores de seguridad y producción (bloqueados por defecto hasta validación)
PUBLIC_BOOKINGS_ENABLED=true
LIVE_PAYMENTS_ENABLED=false
FISCAL_ISSUANCE_ENABLED=false
MARKETING_AUTOMATIONS_ENABLED=false
